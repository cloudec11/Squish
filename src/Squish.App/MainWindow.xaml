<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Squish.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Squish.App.ViewModels"
    xmlns:local="using:Squish.App"
    Title="Squish">

    <Grid x:Name="Root" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop"
          KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="V" Invoked="Paste_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="Browse_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Title bar, merged into the content -->
        <Grid x:Name="TitleBarArea" Grid.Row="0" Padding="16,0,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionButtonsColumn" Width="138" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/Squish-32.png" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Squish" VerticalAlignment="Center" FontSize="{StaticResource CaptionSize}" />
            <Button x:Name="SettingsButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE713;"
                    ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings">
                <Button.Flyout>
                    <Flyout x:Name="SettingsFlyout" Placement="BottomEdgeAlignedRight" Opening="SettingsFlyout_Opening">
                        <ScrollViewer MaxHeight="560" Width="300">
                            <StackPanel Spacing="16" Padding="0,0,8,0">
                                <TextBlock Text="Settings" Style="{StaticResource BodyStrongText}" />

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Save results" Style="{StaticResource CaptionText}" />
                                    <RadioButtons x:Name="OutputLocationRadios" SelectionChanged="OutputLocation_Changed">
                                        <x:String>Beside the original file</x:String>
                                        <x:String>In one folder</x:String>
                                    </RadioButtons>
                                    <Grid x:Name="FolderRow" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="FolderText" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="Choose…" Click="ChooseFolder_Click" />
                                    </Grid>
                                </StackPanel>

                                <ComboBox x:Name="ImageFormatBox" Header="Image format" HorizontalAlignment="Stretch" SelectionChanged="ImageFormat_Changed">
                                    <x:String>Auto</x:String>
                                    <x:String>JPEG</x:String>
                                    <x:String>PNG</x:String>
                                    <x:String>WebP</x:String>
                                </ComboBox>

                                <StackPanel Spacing="4">
                                    <ComboBox x:Name="CodecBox" Header="Video codec" HorizontalAlignment="Stretch" SelectedIndex="0">
                                        <x:String>H.264 (plays everywhere)</x:String>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                               Text="HEVC and AV1 will appear here once they're confirmed to play inline in Discord." />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <ToggleSwitch x:Name="HardwareToggle" Header="Use the graphics card in Fast mode" Toggled="Hardware_Toggled" />
                                    <TextBlock x:Name="HardwareText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Text="Checking…" />
                                </StackPanel>

                                <ComboBox x:Name="ThemeBox" Header="Theme" HorizontalAlignment="Stretch" SelectionChanged="Theme_Changed">
                                    <x:String>System</x:String>
                                    <x:String>Light</x:String>
                                    <x:String>Dark</x:String>
                                </ComboBox>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="About" Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="VersionText" Style="{StaticResource BodyText}" />
                                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                               Text="Works offline. Nothing is uploaded. Location data (EXIF GPS) is removed from images it compresses." />
                                    <HyperlinkButton Content="Licences" Click="Licences_Click" Padding="0" />
                                    <HyperlinkButton Content="Open logs folder" Click="Logs_Click" Padding="0" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- 2. Target row -->
        <StackPanel Grid.Row="1" Padding="16,0,16,8" Spacing="4">
            <Border Background="{ThemeResource ControlAltFillColorSecondaryBrush}" CornerRadius="4" Padding="2"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid x:Name="SegmentGrid" ColumnSpacing="2" AutomationProperties.Name="Target size in megabytes" />
            </Border>
            <TextBlock Text="{x:Bind ViewModel.TargetCaption, Mode=OneWay}" Style="{StaticResource CaptionText}"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <!-- 3. Main area: drop zone or queue -->
        <Grid Grid.Row="2">
            <Border x:Name="DropZone" Margin="16,0,16,8" CornerRadius="8" BorderThickness="2"
                    BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" Padding="24">
                    <FontIcon Glyph="&#xE898;" FontSize="48" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Drop videos, images or GIFs here" Style="{StaticResource BodyText}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <Button x:Name="BrowseButton" Content="Browse" HorizontalAlignment="Center" Click="Browse_Click"
                            AutomationProperties.Name="Browse for files" />
                </StackPanel>
            </Border>

            <ListView x:Name="ItemsList" ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="Single"
                      Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}" Padding="8,0,8,8"
                      KeyDown="ItemsList_KeyDown" CanDragItems="False"
                      AutomationProperties.Name="Files">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="16" />
                        <AddDeleteThemeTransition />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileItemViewModel">
                        <Border Style="{StaticResource CardBorder}" CanDrag="{x:Bind HasOutput, Mode=OneWay}"
                                DragStarting="Card_DragStarting"
                                AutomationProperties.Name="{x:Bind AutomationText, Mode=OneWay}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail -->
                                <Grid Width="64" Height="64" VerticalAlignment="Top">
                                    <Border CornerRadius="{StaticResource ThumbRadius}" Background="{ThemeResource ControlAltFillColorTertiaryBrush}">
                                        <FontIcon Glyph="&#xE8B9;" FontSize="24" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Border>
                                    <Border CornerRadius="{StaticResource ThumbRadius}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{x:Bind local:MainWindow.AsImage(Thumbnail), Mode=OneWay}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <Border Visibility="{x:Bind local:MainWindow.Has(StateGlyph), Mode=OneWay}"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="2"
                                            Width="20" Height="20" CornerRadius="10"
                                            Background="{x:Bind local:MainWindow.StateBrush(State), Mode=OneWay}">
                                        <FontIcon Glyph="{x:Bind StateGlyph, Mode=OneWay}" FontSize="12" Foreground="White" />
                                    </Border>
                                </Grid>

                                <!-- Text -->
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongText}" ToolTipService.ToolTip="{x:Bind Path}" />
                                    <TextBlock Text="{x:Bind DetailLine, Mode=OneWay}" Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="{x:Bind PredictionLine, Mode=OneWay}" Style="{StaticResource CaptionText}"
                                               Visibility="{x:Bind local:MainWindow.Not(IsWorking), Mode=OneWay}" />
                                    <Border Visibility="{x:Bind HasWarning, Mode=OneWay}" HorizontalAlignment="Left"
                                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="0,2,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                            <TextBlock Text="{x:Bind Warning, Mode=OneWay}" FontSize="{StaticResource CaptionSize}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" Margin="0,4,0,0"
                                                 Visibility="{x:Bind IsWorking, Mode=OneWay}"
                                                 AutomationProperties.Name="{x:Bind Name}" />
                                    <TextBlock Text="{x:Bind StatusLine, Mode=OneWay}" FontSize="{StaticResource CaptionSize}"
                                               Foreground="{x:Bind local:MainWindow.StatusBrush(State), Mode=OneWay}"
                                               TextWrapping="Wrap" MaxLines="2"
                                               Visibility="{x:Bind local:MainWindow.Has(StatusLine), Mode=OneWay}"
                                               AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="0">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" Command="{x:Bind CopyCommand}"
                                            Visibility="{x:Bind HasOutput, Mode=OneWay}" ToolTipService.ToolTip="Copy"
                                            AutomationProperties.Name="Copy" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE838;" Command="{x:Bind ShowInFolderCommand}"
                                            Visibility="{x:Bind IsDone, Mode=OneWay}" ToolTipService.ToolTip="Show in folder"
                                            AutomationProperties.Name="Show in folder" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{x:Bind RetryCommand}"
                                            Visibility="{x:Bind IsFailed, Mode=OneWay}" ToolTipService.ToolTip="Retry"
                                            AutomationProperties.Name="Retry" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" Command="{x:Bind CancelCommand}"
                                            Visibility="{x:Bind IsWorking, Mode=OneWay}" ToolTipService.ToolTip="Cancel"
                                            AutomationProperties.Name="Cancel" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE712;" ToolTipService.ToolTip="More options"
                                            Visibility="{x:Bind IsQueued, Mode=OneWay}" AutomationProperties.Name="More options">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutSubItem Text="Size for this file">
                                                    <MenuFlyoutItem Text="Same as the rest" Command="{x:Bind SetTargetCommand}" />
                                                    <MenuFlyoutItem Text="10 MB" Command="{x:Bind SetTargetCommand}" CommandParameter="10" />
                                                    <MenuFlyoutItem Text="20 MB" Command="{x:Bind SetTargetCommand}" CommandParameter="20" />
                                                    <MenuFlyoutItem Text="50 MB" Command="{x:Bind SetTargetCommand}" CommandParameter="50" />
                                                    <MenuFlyoutItem Text="100 MB" Command="{x:Bind SetTargetCommand}" CommandParameter="100" />
                                                    <MenuFlyoutItem Text="500 MB" Command="{x:Bind SetTargetCommand}" CommandParameter="500" />
                                                </MenuFlyoutSubItem>
                                                <MenuFlyoutSubItem Text="Format" Visibility="{x:Bind IsImage, Mode=OneWay}">
                                                    <MenuFlyoutItem Text="Auto" Command="{x:Bind SetFormatCommand}" CommandParameter="Auto" />
                                                    <MenuFlyoutItem Text="JPEG" Command="{x:Bind SetFormatCommand}" CommandParameter="Jpeg" />
                                                    <MenuFlyoutItem Text="PNG" Command="{x:Bind SetFormatCommand}" CommandParameter="Png" />
                                                    <MenuFlyoutItem Text="WebP" Command="{x:Bind SetFormatCommand}" CommandParameter="WebP" />
                                                </MenuFlyoutSubItem>
                                                <MenuFlyoutSubItem Text="Format" Visibility="{x:Bind IsAnimated, Mode=OneWay}">
                                                    <MenuFlyoutItem Text="Keep as GIF" Command="{x:Bind SetFormatCommand}" CommandParameter="Auto" />
                                                    <MenuFlyoutItem Text="Convert to video (smaller, sharper)" Command="{x:Bind SetFormatCommand}" CommandParameter="Video" />
                                                </MenuFlyoutSubItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" Command="{x:Bind RemoveCommand}"
                                            Visibility="{x:Bind local:MainWindow.Not(IsWorking), Mode=OneWay}"
                                            ToolTipService.ToolTip="Remove" AutomationProperties.Name="Remove" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- 4. Action bar -->
        <Grid Grid.Row="3" Padding="16,8,16,16" RowSpacing="4" ColumnSpacing="8"
              Background="{ThemeResource LayerOnMicaBaseAltFillColorTransparentBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PrimaryButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="PrimaryButton"
                    Content="{x:Bind ViewModel.PrimaryText, Mode=OneWay}" Command="{x:Bind ViewModel.PrimaryCommand}"
                    IsEnabled="{x:Bind ViewModel.HasItems, Mode=OneWay}" MinHeight="32">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                </Button.KeyboardAccelerators>
            </Button>
            <Border Grid.Column="1" Background="{ThemeResource ControlAltFillColorSecondaryBrush}" CornerRadius="4" Padding="2"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleButton x:Name="BestToggle" Content="Best" Style="{StaticResource SegmentButton}" Click="Best_Click"
                                  ToolTipService.ToolTip="Best quality: slower, two-pass encode" />
                    <ToggleButton x:Name="FastToggle" Content="Fast" Style="{StaticResource SegmentButton}" Click="Fast_Click"
                                  ToolTipService.ToolTip="Fast: uses the graphics card when it can" />
                </StackPanel>
            </Border>
            <Button Grid.Column="2" Content="Clear" Command="{x:Bind ViewModel.ClearCommand}"
                    IsEnabled="{x:Bind ViewModel.CanClear, Mode=OneWay}" MinHeight="32" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{x:Bind ViewModel.AttachmentNote, Mode=OneWay}"
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                       Visibility="{x:Bind local:MainWindow.Has(ViewModel.AttachmentNote), Mode=OneWay}" />
        </Grid>

        <!-- Screen reader announcements -->
        <TextBlock x:Name="LiveRegion" Width="1" Height="1" Opacity="0" IsHitTestVisible="False"
                   AutomationProperties.LiveSetting="Assertive" Grid.Row="0" />
    </Grid>
</Window>
